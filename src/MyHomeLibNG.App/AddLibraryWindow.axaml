<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyHomeLibNG.App.AddLibraryWindow"
        Width="560"
        Height="560"
        MinWidth="520"
        MinHeight="520"
        Title="Add Library"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF4F1EA">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Border Background="#FFFBF9F4" BorderBrush="#FFE0D9CC" BorderThickness="1" CornerRadius="22" Padding="22">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Add library" FontSize="24" FontWeight="SemiBold" Foreground="#FF1F2527" />
        <TextBlock Text="Choose a source type and enter its connection details." Foreground="#FF5E676B" />
      </StackPanel>

      <Border x:Name="ValidationMessageBorder"
              Grid.Row="1"
              Margin="0,16,0,0"
              Background="#FFFEF1E2"
              BorderBrush="#FFE4A85F"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12"
              IsVisible="{Binding HasValidationMessage}">
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="#FF6F4A12" />
      </Border>

      <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Source type" FontWeight="SemiBold" Foreground="#FF1F2527" />
          <StackPanel Orientation="Horizontal" Spacing="18">
            <RadioButton x:Name="OfflineSourceRadioButton"
                         Content="Offline library"
                         IsChecked="{Binding IsOfflineSourceSelected}" />
            <RadioButton x:Name="OnlineSourceRadioButton"
                         Content="Online source"
                         IsChecked="{Binding IsOnlineSourceSelected}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Preset" FontWeight="SemiBold" Foreground="#FF1F2527" />
          <ComboBox x:Name="ProviderOptionsComboBox"
                    ItemsSource="{Binding OnlineProviderOptions}"
                    SelectedItem="{Binding SelectedOption}"
                    IsVisible="{Binding IsOnlineSourceSelected}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Display name" FontWeight="SemiBold" Foreground="#FF1F2527" />
          <TextBox x:Name="LibraryNameTextBox" Text="{Binding LibraryName}" Watermark="My offline shelf" />
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="3" Margin="0,16,0,0">
        <StackPanel Spacing="14">
          <Border Background="#FFF0ECE3" CornerRadius="16" Padding="14">
            <TextBlock Text="{Binding SelectedOption.Description}" TextWrapping="Wrap" Foreground="#FF5E676B" />
          </Border>

          <StackPanel x:Name="OfflineFieldsPanel" Spacing="10" IsVisible="{Binding IsOfflineSourceSelected}">
            <StackPanel Spacing="6">
              <TextBlock Text="INPX file path" FontWeight="SemiBold" Foreground="#FF1F2527" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="InpxFilePathTextBox" Text="{Binding InpxFilePath}" Watermark="C:\Books\catalog.inpx" />
                <Button Grid.Column="1" Margin="10,0,0,0" Content="Browse..." Click="OnBrowseInpxClicked" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Archive folder" FontWeight="SemiBold" Foreground="#FF1F2527" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="ArchiveDirectoryPathTextBox" Text="{Binding ArchiveDirectoryPath}" Watermark="C:\Books\Archives" />
                <Button Grid.Column="1" Margin="10,0,0,0" Content="Browse..." Click="OnBrowseArchiveClicked" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="OnlineDetailsPanel" Spacing="10" IsVisible="{Binding IsOnlineSourceSelected}">
            <StackPanel Spacing="6">
              <TextBlock Text="URL" FontWeight="SemiBold" Foreground="#FF1F2527" />
              <TextBox x:Name="OnlineSourceUrlTextBox" Text="{Binding OnlineSourceUrl}" Watermark="https://openlibrary.org" />
            </StackPanel>
            <Border Background="#FFFFFFFF" BorderBrush="#FFE0D9CC" BorderThickness="1" CornerRadius="16" Padding="14">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="Base URL" Foreground="#FF5E676B" />
                <TextBlock Grid.Column="1" Margin="12,0,0,8" Text="{Binding SelectedOption.ApiBaseUrl}" TextWrapping="Wrap" Foreground="#FF1F2527" />
                <TextBlock Grid.Row="1" Text="Search" Foreground="#FF5E676B" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Text="{Binding SelectedOption.SearchEndpoint}" TextWrapping="Wrap" Foreground="#FF1F2527" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Click="OnCancelClicked" />
        <Button Background="#FF2B6A69"
                Foreground="White"
                BorderBrush="#FF2B6A69"
                CornerRadius="12"
                Padding="16,10"
                Content="Add library"
                Click="OnSaveClicked" />
      </StackPanel>
    </Grid>
  </Border>
  </ScrollViewer>
</Window>
